<Window x:Class="ISIP422_Afanasev_Razumovskaya.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ISIP422_Afanasev_Razumovskaya.Models"
        xmlns:vm="clr-namespace:ISIP422_Afanasev_Razumovskaya.ViewModels"
        Title="🏪 Система учёта товаров" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        MinHeight="700" MinWidth="1200">

    <Window.Resources>
        <!-- Современные стили -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0056B3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004085"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E7E34"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#17A2B8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#138496"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#545B62"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#007BFF"/>
                                <Setter Property="Background" Value="#F8F9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00000020" Direction="270" ShadowDepth="2" BlurRadius="8"/>
                                </Border.Effect>
                            </Border>
                            <Label Content="{TemplateBinding Header}" 
                                   Background="White" 
                                   Margin="20,-8,0,0" 
                                   Padding="8,0" 
                                   FontWeight="Bold" 
                                   FontSize="14"
                                   Foreground="#495057"
                                   VerticalAlignment="Top"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" 
                                            Content="{TemplateBinding Content}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F8F9FA"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <!-- Градиентный фон -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8F9FA" Offset="0"/>
                <GradientStop Color="#E9ECEF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок с градиентом -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" 
                Background="#007BFF"
                CornerRadius="0,0,20,20"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#007BFF40" Direction="270" ShadowDepth="4" BlurRadius="15"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical" 
                       HorizontalAlignment="Center" 
                       Margin="20">
                <TextBlock Text="🏪 СИСТЕМА УЧЁТА ТОВАРОВ В МАГАЗИНЕ" 
                          FontSize="28" FontWeight="Bold" 
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Современное решение для управления складом" 
                          FontSize="14" 
                          Foreground="#B3D7FF"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Список товаров -->
        <GroupBox Grid.Row="1" Grid.Column="0" 
                  Header="📦 Список товаров в наличии" 
                  Style="{StaticResource ModernGroupBox}"
                  Margin="20,0,10,20">
            <DataGrid ItemsSource="{Binding Products}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="🏷️ Код" Binding="{Binding Code}" Width="100">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#007BFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="📝 Название" Binding="{Binding Name}" Width="*">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#007BFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="💰 Цена" Binding="{Binding Price, StringFormat=C}" Width="120">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#007BFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="📊 Количество" Binding="{Binding Quantity}" Width="100">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#007BFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="✅ В наличии" Width="100">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#007BFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding InStock, Converter={x:Static local:BoolToColorConverter.Instance}}" 
                                        CornerRadius="10" Padding="8,4">
                                    <TextBlock Text="{Binding InStock, Converter={x:Static local:BoolToTextConverter.Instance}}" 
                                               Foreground="White" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="🏷️ Категория" Binding="{Binding Category}" Width="140">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#007BFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Панель управления -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" 
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,0,20,20">

                <!-- Добавление товара -->
                <GroupBox Header="➕ Добавить новый товар" 
                         Style="{StaticResource ModernGroupBox}">
                    <StackPanel>
                        <Label Content="Название товара:" FontWeight="SemiBold" Foreground="#495057"/>
                        <TextBox Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}" 
                               Style="{StaticResource ModernTextBox}"
                               ToolTip="Введите название товара (минимум 2 символа)"/>

                        <Label Content="Цена (₽):" FontWeight="SemiBold" Foreground="#495057" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding NewProductPrice, UpdateSourceTrigger=PropertyChanged}" 
                               Style="{StaticResource ModernTextBox}"
                               ToolTip="Введите цену товара (от 1 до 1,000,000 рублей)"/>

                        <Label Content="Количество (шт.):" FontWeight="SemiBold" Foreground="#495057" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding NewProductQuantity, UpdateSourceTrigger=PropertyChanged}" 
                               Style="{StaticResource ModernTextBox}"
                               ToolTip="Введите количество товара (от 0 до 10,000 штук)"/>

                        <Label Content="Категория:" FontWeight="SemiBold" Foreground="#495057" Margin="0,10,0,0"/>
                        <ComboBox SelectedItem="{Binding NewProductCategory}" 
                                Style="{StaticResource ModernComboBox}"
                                ToolTip="Выберите категорию товара">
                            <models:Category>Electronics</models:Category>
                            <models:Category>Clothing</models:Category>
                            <models:Category>Food</models:Category>
                            <models:Category>Books</models:Category>
                            <models:Category>Home</models:Category>
                        </ComboBox>

                        <Button Content="➕ Добавить товар" 
                              Command="{Binding AddProductCommand}"
                              Style="{StaticResource SuccessButton}"
                              Margin="0,15,0,0"
                              ToolTip="Добавить товар в систему"/>
                    </StackPanel>
                </GroupBox>

                <!-- Операции с товарами -->
                <GroupBox Header="🔧 Операции с товарами" 
                         Style="{StaticResource ModernGroupBox}">
                    <StackPanel>
                        <Label Content="Код товара:" FontWeight="SemiBold" Foreground="#495057"/>
                        <TextBox Text="{Binding SelectedProductCode, UpdateSourceTrigger=PropertyChanged}" 
                               Style="{StaticResource ModernTextBox}"
                               ToolTip="Введите код товара для операций (например: 100001)"/>

                        <!-- Продажа -->
                        <Border Background="#FFF3CD" 
                              BorderBrush="#FFC107" 
                              BorderThickness="1" 
                              CornerRadius="8" 
                              Padding="12" 
                              Margin="0,15,0,10">
                            <StackPanel>
                                <Label Content="💰 Продажа товара" FontWeight="Bold" Foreground="#856404"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Label Content="Количество:" Width="100" Foreground="#856404"/>
                                    <TextBox Text="{Binding SellQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                           Width="80" 
                                           Style="{StaticResource ModernTextBox}"
                                           Margin="5,0"/>
                                    <Button Content="🛒 Продать" 
                                          Command="{Binding SellProductCommand}"
                                          Style="{StaticResource WarningButton}"
                                          ToolTip="Продать указанное количество товара"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Пополнение -->
                        <Border Background="#D1ECF1" 
                              BorderBrush="#17A2B8" 
                              BorderThickness="1" 
                              CornerRadius="8" 
                              Padding="12" 
                              Margin="0,0,0,10">
                            <StackPanel>
                                <Label Content="📦 Пополнение склада" FontWeight="Bold" Foreground="#0C5460"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Label Content="Количество:" Width="100" Foreground="#0C5460"/>
                                    <TextBox Text="{Binding RestockQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                           Width="80" 
                                           Style="{StaticResource ModernTextBox}"
                                           Margin="5,0"/>
                                    <Button Content="📥 Пополнить" 
                                          Command="{Binding RestockProductCommand}"
                                          Style="{StaticResource InfoButton}"
                                          ToolTip="Пополнить склад указанным количеством"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Удаление -->
                        <Button Content="🗑️ Удалить товар" 
                              Command="{Binding RemoveProductCommand}"
                              Style="{StaticResource DangerButton}"
                              ToolTip="Удалить товар из системы (необратимо)"/>
                    </StackPanel>
                </GroupBox>

                <!-- Поиск -->
                <GroupBox Header="🔍 Поиск товаров" 
                         Style="{StaticResource ModernGroupBox}">
                    <StackPanel>
                        <Label Content="Поисковый запрос:" FontWeight="SemiBold" Foreground="#495057"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                               Style="{StaticResource ModernTextBox}"
                               ToolTip="Введите текст для поиска"/>

                        <Label Content="Критерий поиска:" FontWeight="SemiBold" Foreground="#495057" Margin="0,10,0,0"/>
                        <ComboBox SelectedValue="{Binding SelectedSearchType}" 
                                Style="{StaticResource ModernComboBox}"
                                ToolTip="Выберите по какому полю искать">
                            <ComboBoxItem Content="🏷️ По названию" Tag="name"/>
                            <ComboBoxItem Content="🔢 По коду" Tag="code"/>
                            <ComboBoxItem Content="📂 По категории" Tag="category"/>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Content="🔍 Найти" 
                                  Command="{Binding SearchProductsCommand}"
                                  Style="{StaticResource ModernButton}"
                                  ToolTip="Начать поиск товаров"/>
                            <Button Content="🗑️ Очистить" 
                                  Command="{Binding ClearSearchCommand}"
                                  Style="{StaticResource SecondaryButton}"
                                  ToolTip="Очистить результаты поиска"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- История продаж и отчёты -->
                <GroupBox Header="📈 Аналитика и отчёты" 
                         Style="{StaticResource ModernGroupBox}">
                    <StackPanel>
                        <Button Content="↶ Отменить последнюю продажу" 
                              Command="{Binding UndoLastSaleCommand}"
                              Style="{StaticResource SecondaryButton}"
                              ToolTip="Отменить последнюю совершённую продажу"/>

                        <Button Content="📊 Подробный отчёт о продажах" 
                              Command="{Binding ShowSalesReportCommand}"
                              Style="{StaticResource InfoButton}"
                              ToolTip="Показать детальный отчёт по всем продажам"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Результаты поиска -->
        <GroupBox Grid.Row="2" Grid.ColumnSpan="2" 
                 Header="🎯 Результаты поиска" 
                 Style="{StaticResource ModernGroupBox}"
                 Margin="20,0,20,20">
            <DataGrid ItemsSource="{Binding SearchResults}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      Style="{StaticResource ModernDataGrid}"
                      MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="🏷️ Код" Binding="{Binding Code}" Width="100">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#28A745"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="📝 Название" Binding="{Binding Name}" Width="*">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#28A745"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="💰 Цена" Binding="{Binding Price, StringFormat=C}" Width="120">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#28A745"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="📊 Количество" Binding="{Binding Quantity}" Width="100">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#28A745"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="✅ В наличии" Width="100">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#28A745"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding InStock, Converter={x:Static local:BoolToColorConverter.Instance}}" 
                                        CornerRadius="10" Padding="8,4">
                                    <TextBlock Text="{Binding InStock, Converter={x:Static local:BoolToTextConverter.Instance}}" 
                                               Foreground="White" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="🏷️ Категория" Binding="{Binding Category}" Width="140">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#28A745"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

    </Grid>
</Window>